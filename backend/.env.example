# ===== LLM 配置 =====
# DeepSeek API Key（留空自动启用 Mock 模式）
DEEPSEEK_API_KEY=
# DeepSeek API 地址（兼容 OpenAI 格式）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 模型名
DEEPSEEK_MODEL=deepseek-chat

# ===== Mock 模式 =====
# true=使用规则式回答（无需 API Key，演示用）
# false=使用 DeepSeek API
MOCK_LLM=true

# ===== Embedding 模型 =====
# bge-small-zh-v1.5 本地模型路径
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# 模型缓存目录
MODELS_DIR=/app/models

# ===== 文档处理 =====
# 段落切分目标大小（字符数）
CHUNK_SIZE=600
# 段落重叠大小
CHUNK_OVERLAP=100
# 文件大小上限（MB）
MAX_FILE_SIZE_MB=20

# ===== 检索配置 =====
# 默认返回的文档片段数
DEFAULT_TOP_K=5

# ===== Prompt 模板 =====
QA_PROMPT="你是一个专业的企业文档问答助手。请根据以下文档内容回答用户的问题。\n\n## 规则\n- 只根据提供的文档内容回答，不要编造信息\n- 如果文档中没有相关信息，请明确告知用户\n- 回答要清晰、准确、有条理\n- 在回答中使用 [1]、[2] 等标记引用来源\n\n## 相关文档内容\n{context}\n\n## 用户问题\n{question}\n\n## 回答（带引用标记）"
